# Database (matches docker-compose.yml)
DATABASE_URL=postgres://mailbox:mailbox@localhost:5432/mailbox_orders
# Optional: used by `npm test` (defaults to the value below)
DATABASE_URL_TEST=postgres://mailbox:mailbox@localhost:5432/mailbox_orders_test

# Session cookie signing key (min 16 chars). Change in any real deployment.
SESSION_SECRET=dev-only-secret-change-me-please

# Mock provider behaviour (worker)
PROVIDER_FAILURE_RATE=0.2
PROVIDER_MIN_MS=2000
PROVIDER_MAX_MS=4000

# Worker
WORKER_POLL_MS=2000
WORKER_CONCURRENCY=5
# An order stuck in PROVISIONING longer than this is marked FAILED (worker crash recovery)
STALE_MINUTES=10
